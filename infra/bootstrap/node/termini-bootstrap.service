[Unit]
Description=Termini node bootstrap (register + telemetry)
Documentation=file:/opt/termini/README.md
# Registration is the first thing the node does; it needs the underlay up but not
# the full multi-user world. Activation-only image: the unit is inert until
# cloud-init has written the per-node config (docs/contracts/node-bootstrap.md §3.2).
Wants=network-online.target
After=network-online.target
# The node's own LXD REST API is the endpoint the controller executes operator
# actions against, so it is ordered before registration. Ordered, NOT Requisite:
# the daemon repairs/verifies the listener itself (`ensure_lxd_api`) and fails
# closed with the distinct state LXD_API_UNAVAILABLE when it cannot, so a slow or
# distro-packaged LXD must not leave the unit stuck in "dependency failed".
Wants=snap.lxd.daemon.service
After=snap.lxd.daemon.service lxd.service
# First-boot offline preflight ordering. The image pipeline installs
# termini-firstboot-preflight.service (image/pipeline) and orders it Before= this
# unit (see that unit's [Unit] section); this After= keeps the relationship
# explicit on the node even when the preflight unit is absent (then a no-op).
#
# The preflight is deliberately NOT a hard Requisite gate here: the demo alias
# mounts the pinned GGUF weights at launch (/var/lib/termini/models) instead of
# baking them, so gating activation on their baked presence would refuse to start
# the daemon on a valid node. A node still fails loudly — the preflight writes its
# verdict to /var/log/termini/first-boot.json.
After=termini-firstboot-preflight.service
ConditionPathExists=/etc/termini/config.yaml

[Service]
# Type=notify: the unit is only `active` after the daemon sends READY=1, which it
# does ONLY once the controller acknowledges registration (2xx). A node that is
# still connecting stays `activating`; a terminal enrollment failure never reports
# ready. `TimeoutStartSec=infinity` keeps the documented ACTIVATING/wait state
# legal for a node that boots before its config/token exists.
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/termini-bootstrap
Restart=always
RestartSec=2
TimeoutStartSec=infinity
# The agent needs no inbound socket and no privileged operations in the demo.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
