# Copy to terraform.tfvars and fill in the project id, then `terraform apply`.
# terraform.tfvars is gitignored; never commit a real project id or key material.

project = "REPLACE_WITH_YOUR_GCP_PROJECT_ID"
region  = "us-central1"
zone    = "us-central1-a"

# Frozen underlay plan (docs/contracts/infra-decisions.md D2).
network_cidr = "10.10.0.0/24"

# Node C is CPU-only by default (free-tier billing rejects every non-TPU
# accelerator). A/B compute-optimized; C is CPU-heavy to host llama.cpp on CPU.
#
# Mind the project's CPUS_ALL_REGIONS quota: 4 + 4 + 8 = 16 vCPU. The demo project
# is capped at 12, so its tfvars uses compute_machine_type = "n2-standard-2"
# (2 + 2 + 8 = 12) to keep Node C at n2-standard-8.
compute_machine_type   = "n2-standard-4"
inference_machine_type = "n2-standard-8"
gpu_accelerator_type   = "nvidia-l4"
gpu_accelerator_count  = 0

# Node C serves the pinned deepseek-flash GGUF on CPU on the frozen contract port
# (image/models.lock.json, t_ab18d582). Override inference_model_url / _file /
# _sha256 / _alias to serve a different weight (the .sha256 must match or first
# boot aborts).
serve_inference       = true
inference_port        = 8080
inference_model_file  = "DeepSeek-R1-Distill-Llama-8B-Q4_K_M.gguf"
inference_model_sha256 = "87bcba20b4846d8dadf753d3ff48f9285d131fc95e3e0e7e934d4f20bc896f5d"
inference_model_alias = "deepseek-flash"

# To re-enable the GPU after upgrading the billing account to paid, set:
#   inference_machine_type = "g2-standard-4"
#   gpu_accelerator_count  = 1

# DEMO ONLY — lock this down before any real use (your admin CIDR or 35.235.240.0/20 for IAP).
ssh_source_ranges = ["0.0.0.0/0"]
ssh_user          = "ubuntu"

# Where downstream tasks read the node inventory from.
inventory_path = "/home/ubuntu/.termini/inventory.json"
