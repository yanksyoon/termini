# Copy to terraform.tfvars and fill in the project id, then `terraform apply`.
# terraform.tfvars is gitignored; never commit a real project id or key material.

project = "REPLACE_WITH_YOUR_GCP_PROJECT_ID"
region  = "us-central1"
zone    = "us-central1-a"

# Frozen underlay plan (docs/contracts/infra-decisions.md D2).
network_cidr = "10.10.0.0/24"

# Node C is CPU-only by default (free-tier billing rejects every non-TPU
# accelerator). A/B compute-optimized; C is CPU-heavy to host llama.cpp on CPU.
#
# Mind the project's CPUS_ALL_REGIONS quota: 4 + 4 + 8 = 16 vCPU. The demo project
# is capped at 12, so its tfvars uses compute_machine_type = "n2-standard-2"
# (2 + 2 + 8 = 12) to keep Node C at n2-standard-8.
compute_machine_type   = "n2-standard-4"
inference_machine_type = "n2-standard-8"
gpu_accelerator_type   = "nvidia-l4"
gpu_accelerator_count  = 0

# Node C serves the pinned gemma GGUF on CPU through the inference FRONT DOOR on
# the frozen contract port (image/models.lock.json, t_ab18d582; front door from
# t_359ed606). inference_backend picks what a FRESH node serves through it:
#   gemini-proxy (shipped)  the forwarded managed model, labelled in-band
#   local                   this node's own CPU weights behind the same front door
# On a RUNNING node the same choice is `termini-inference-switch local|gemini-proxy`.
# Override inference_model_url / _file / _sha256 / _alias to serve a different
# weight (the .sha256 must match or first boot aborts).
serve_inference        = true
inference_backend      = "gemini-proxy"
inference_port         = 8080
inference_model_file   = "gemma-3-4b-it-Q4_K_M.gguf"
inference_model_sha256 = "04a43a22e8d2003deda5acc262f68ec1005fa76c735a9962a8c77042a74a7d19"
inference_model_alias  = "gemma"

# To re-enable the GPU after upgrading the billing account to paid, set:
#   inference_machine_type = "g2-standard-4"
#   gpu_accelerator_count  = 1

# DEMO ONLY — lock this down before any real use (your admin CIDR or 35.235.240.0/20 for IAP).
ssh_source_ranges = ["0.0.0.0/0"]
ssh_user          = "ubuntu"

# SSH custody (node-bootstrap.md §7). Cloud-init injects team_ssh_public_key into
# every node's authorized_keys (+ sshd hardening); empty falls back to
# ssh_public_key. ssh_public_key is additionally injected via GCP instance
# metadata as the break-glass key. Leave both empty for activation-only nodes.
team_ssh_public_key = "" # e.g. "ssh-ed25519 AAAA... termini-team"
ssh_public_key      = "" # e.g. "ssh-ed25519 AAAA... break-glass"

# Controller wiring written into every node's cloud-init.
controller_url           = "https://controller.termini.internal"
controller_ssh_ca_pubkey = "" # e.g. "ssh-ed25519 AAAA... termini-ssh-ca"
# Single-use, short-TTL token written to /var/lib/termini/enrollment.token
# (node-bootstrap.md §3.2). Empty = nodes activate but cannot register.
enrollment_token = "" # e.g. "eyJhbGciOi..."

# Informational label written to /etc/termini/bootstrap-origin. Empty falls back
# to the boot image family.
node_image_version = ""

# Where downstream tasks read the node inventory from.
inventory_path = "/home/ubuntu/.termini/inventory.json"
