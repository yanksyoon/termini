# --- secrets & credentials (NEVER commit) ---
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
.ssh/

# --- Hermes / agent runtime state ---
.hermes/
.cache/
.config/
.local/
.npm/
.prime/
*.log

# --- this home-is-repo: ignore the OS/shell layer ---
.bash_history
.bash_logout
.bashrc
.profile
.viminfo
.lesshst
.wget-hsts
.sudo_as_admin_successful
.gitconfig

# --- terraform / termini local state ---
*.tfvars
*.auto.tfvars
.terraform/
.termini/

# --- language / tooling ---
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# --- terraform / infrastructure ---
.terraform/
.terraform.d/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
crash.log
infra/gcp/inventory.json

# --- local toolchain installs (this repo root is a home directory) ---
# An operator-installed gcloud/CLI tree lives here and is hundreds of MB; it must
# never be staged. Any cloud SDK installed into $HOME lands in the repo.
google-cloud-sdk/
.gcloudignore

# --- demo / harness run artifacts ---
# chaos/acceptance/seeder output. `*.log` already covers the plain logs, but the
# JSONL audit dumps and summaries are not .log files.
chaos-logs/
scripts/timing/evidence/
*.tfplan
tfplan

# --- shell / network runtime state ---
# Accumulated by tooling (GPG agent sockets, NSS cert DBs, snap). Runtime state,
# never source.
.gnupg/
.pki/
snap/
.bashrc.backup
.bashrc.*.bak


