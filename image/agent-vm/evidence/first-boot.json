    },
    "config": {
      "path": "/etc/termini/agent.yaml",
      "status": "valid",
      "inference_base_url": "http://10.10.0.13:8080",
      "default_model": "deepseek-flash",
      "allowed_models": [
        "deepseek-flash",
        "deepseek-v4-pro"
      ]
    },
    "ok": true
  },
  "verdict": "pass",
  "network_downloads_at_boot": 0,
  "verified_offline": true
