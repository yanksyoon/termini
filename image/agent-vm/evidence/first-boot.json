  "deps": [
    {
      "module": "openai",
      "status": "ok"
    },
    {
      "module": "httpx",
      "status": "ok"
    },
    {
      "module": "pydantic",
      "status": "ok"
    },
    {
      "module": "yaml",
      "status": "ok"
    },
    {
      "module": "tenacity",
      "status": "ok"
    },
    {
      "module": "structlog",
      "status": "ok"
    },
    {
      "module": "langchain_core",
      "status": "ok"
    },
    {
      "module": "langgraph",
      "status": "ok"
    },
    {
      "module": "google.adk",
      "status": "ok"
    }
  ],
  "selfcheck": {
    "kind": "termini.agent_selfcheck",
    "agent_version": "2026.10.0",
    "python": "3.12.3",
    "runtime_imports": {
      "openai": "ok",
      "httpx": "ok",
      "pydantic": "ok",
      "yaml": "ok",
