[Unit]
Description=Termini first-boot offline preflight (proves baked artifacts resolve from local disk)
Documentation=file:///opt/termini/README.md
DefaultDependencies=no
After=local-fs.target
Before=termini-bootstrap.service
ConditionPathExists=!/var/lib/termini/.preflight-done

[Service]
Type=oneshot
RemainAfterExit=yes
# Exit non-zero => the bootstrap daemon is not gated on success here (the unit is
# ordered Before= termini-bootstrap.service, which carries the matching After=);
# the grep-able verdict in /var/log/termini/first-boot.json is the gate signal.
# See image/README.md §4 for why this is ordered, not a hard Requisite=.
ExecStart=/usr/local/sbin/termini-first-boot-preflight --log-out /var/log/termini/first-boot.json
ExecStartPost=/usr/bin/touch /var/lib/termini/.preflight-done
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
