{
  "schema_version": 1,
  "controller": {
    "host": "127.0.0.1",
    "port": 18090,
    "bootstrap_token": "chaos-bootstrap",
    "project_token": "chaos-project-token"
  },
  "lxd": {
    "mode": "stub",
    "host": "127.0.0.1",
    "port": 18443,
    "url": null,
    "mutation_status": "sync"
  },
  "operator": {
    "poll_interval_s": 1.0,
    "grace_s": 4.0,
    "cmd": null,
    "dry_run": false
  },
  "thresholds": {
    "oom_ram_pct": 95.0,
    "oom_consecutive": 2
  },
  "node": {
    "hostname": "node-chaos",
    "cadence_ms": 1000,
    "cpu_core_count": 16,
    "ram_total_bytes": 34359738368,
    "disk_total_bytes": 274877906944,
    "gpu": false
  },
  "scenarios": {
    "oom": {
      "mode": "oom",
      "description": "Ramp host RAM utilisation past the OOM threshold and hold it long enough to sustain the rule.",
      "duration_s": 8,
      "expect": {"rule": "oom-guard-01", "remediation": true, "action": "vm.restart"},
      "params": {"ram_start_pct": 62.0, "ram_peak_pct": 97.0, "ramp_s": 3.0}
    },
    "disk-fail": {
      "mode": "disk-fail",
      "description": "Flip a disk mount read-only (EXT4 remount-ro) — the Scenario B signature.",
      "duration_s": 8,
      "expect": {"rule": "disk-fail-01", "remediation": true, "action": "disk.drain"},
      "params": {"fail_after_s": 1.0}
    },
    "healthy": {
      "mode": "healthy",
      "description": "Steady baseline (false-positive guard): must produce no health events and no commands.",
      "duration_s": 6,
      "expect": {"rule": null, "remediation": false, "action": null},
      "params": {}
    }
  }
}
